ODROID-C5: fix mediaproxy producer session use-after-free

diff --git a/media_modules/drivers/amvdec_ports/aml_vcodec_dec.c b/media_modules/drivers/amvdec_ports/aml_vcodec_dec.c
--- a/media_modules/drivers/amvdec_ports/aml_vcodec_dec.c
+++ b/media_modules/drivers/amvdec_ports/aml_vcodec_dec.c
@@ -3710,8 +3710,10 @@
 	return 0;
 S_FMT_ERROR:
 #ifdef CONFIG_AMLOGIC_MEDIA_PROXY
-	if (ctx->k_producer_session)
+	if (ctx->k_producer_session) {
 		media_proxy_produce_deinit(ctx->k_producer_session);
+		ctx->k_producer_session = NULL;
+	}
 #endif
 	return -EINVAL;

diff --git a/media_modules/drivers/amvdec_ports/aml_vcodec_dec_drv.c b/media_modules/drivers/amvdec_ports/aml_vcodec_dec_drv.c
--- a/media_modules/drivers/amvdec_ports/aml_vcodec_dec_drv.c
+++ b/media_modules/drivers/amvdec_ports/aml_vcodec_dec_drv.c
@@ -236,8 +236,10 @@
 	aml_vcodec_dec_info_deinit(ctx);
 	aml_vcodec_dec_release(ctx);
 #ifdef CONFIG_AMLOGIC_MEDIA_PROXY
-	if (ctx->k_producer_session)
+	if (ctx->k_producer_session) {
 		media_proxy_produce_deinit(ctx->k_producer_session);
+		ctx->k_producer_session = NULL;
+	}
 #endif
 	v4l2_fh_del(&ctx->fh);
 	v4l2_fh_exit(&ctx->fh);
